<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DiagnoseTool.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        
        <!-- Base Typography & Styling -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Roboto, sans-serif" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        </Style>
        
        <Style Selector="TextBlock.TextHeader">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        </Style>

        <Style Selector="TextBlock.TextSubheader">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        </Style>

        <Style Selector="TextBlock.TextMuted">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
        </Style>

        <!-- Rounded Cards -->
        <Style Selector="Border.CardStyle">
            <Setter Property="Background" Value="{DynamicResource BrushBgCard}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BoxShadow" Value="0 2 8 0 #0F000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
        </Style>

        <!-- Modern Round Buttons -->
        <Style Selector="Button.ModernButton">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ModernButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentCyan}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        </Style>
        <Style Selector="Button.ModernButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#CBD5E1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentCyan}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        </Style>
        <Style Selector="Button.ModernButton:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!-- Primary Action Button -->
        <Style Selector="Button.PrimaryButton">
            <Setter Property="Background" Value="{DynamicResource BrushAccentCyan}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.PrimaryButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0E7490" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BoxShadow" Value="0 2 8 0 #330891B2" />
        </Style>
        <Style Selector="Button.PrimaryButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#155E75" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.PrimaryButton:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!-- Sidebar Navigation Buttons -->
        <Style Selector="RadioButton.SidebarButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="Navigation" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border Name="bgBorder" Background="{TemplateBinding Background}" CornerRadius="6" Margin="4,2"/>
                        <!-- Active indicator bar -->
                        <Border Name="indicator" HorizontalAlignment="Left" Width="4" Height="20" Background="{DynamicResource BrushAccentCyan}" CornerRadius="2" IsVisible="False" Margin="8,0,0,0"/>
                        
                        <ContentPresenter Name="contentPresenter" 
                                          ContentTemplate="{TemplateBinding ContentTemplate}" 
                                          Content="{TemplateBinding Content}" 
                                          HorizontalAlignment="Left" 
                                          VerticalAlignment="Center" 
                                          Margin="24,0,0,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.SidebarButton:pointerover /template/ Border#bgBorder">
            <Setter Property="Background" Value="#F1F5F9" />
        </Style>
        <Style Selector="RadioButton.SidebarButton:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        </Style>
        <Style Selector="RadioButton.SidebarButton:checked /template/ Border#bgBorder">
            <Setter Property="Background" Value="#E0F2FE" />
        </Style>
        <Style Selector="RadioButton.SidebarButton:checked /template/ Border#indicator">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="RadioButton.SidebarButton:checked">
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentCyan}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Modern Custom Progress Bar Style -->
        <Style Selector="ProgressBar.ModernProgressBar">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentCyan}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Height" Value="8" />
            <Setter Property="MinHeight" Value="4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True"
                            Height="{TemplateBinding Height}"
                            MinWidth="0">
                        <Border Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Core Progress Bar Style (Mini, for CPU Core Monitor tiles) -->
        <Style Selector="ProgressBar.CoreProgressBar">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentCyan}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Height" Value="5" />
            <Setter Property="MinHeight" Value="3" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True"
                            Height="{TemplateBinding Height}"
                            MinWidth="0">
                        <Border Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- ListBoxItem styling for battery log -->
        <Style Selector="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas, Menlo, Monaco, monospace"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <!-- ComboBox styling -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentCyan}" />
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#E0F2FE" />
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentCyan}" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <!-- Palette Colors (Light Theme) -->
        <Color x:Key="ColorBgMain">#F8FAFC</Color>
        <Color x:Key="ColorBgSidebar">#FFFFFF</Color>
        <Color x:Key="ColorBgCard">#FFFFFF</Color>
        <Color x:Key="ColorBgCardHover">#F1F5F9</Color>
        
        <Color x:Key="ColorAccentCyan">#0891B2</Color>
        <Color x:Key="ColorAccentPurple">#9333EA</Color>
        
        <Color x:Key="ColorTextPrimary">#0F172A</Color>
        <Color x:Key="ColorTextSecondary">#475569</Color>
        <Color x:Key="ColorTextMuted">#64748B</Color>
        
        <Color x:Key="ColorSuccess">#16A34A</Color>
        <Color x:Key="ColorWarning">#D97706</Color>
        <Color x:Key="ColorDanger">#DC2626</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BrushBgMain" Color="{StaticResource ColorBgMain}" />
        <SolidColorBrush x:Key="BrushBgSidebar" Color="{StaticResource ColorBgSidebar}" />
        <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}" />
        <SolidColorBrush x:Key="BrushBgCardHover" Color="{StaticResource ColorBgCardHover}" />
        
        <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource ColorAccentCyan}" />
        <SolidColorBrush x:Key="BrushAccentPurple" Color="{StaticResource ColorAccentPurple}" />
        
        <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
        <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

        <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
        <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
        <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    </Application.Resources>
</Application>